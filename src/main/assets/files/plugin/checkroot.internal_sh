#!/system/bin/sh

#set -x

check_dir() {
  mincount=$1
  dir=$2
  count=$(ls $dir | wc -l)
  if [[ $count -ge $mincount ]]; then
    echo "checkroot: access to $dir -> $count -> OK"
  else
    echo "checkroot: NO full access to $dir -> $count less than $mincount"
    exit 1
  fi
}

check_uid() {
  id=$(id -u)
  if [[ $id == 0 ]]; then
    echo "checkroot: uid = $id = root -> OK"
  else
    echo "checkroot: uid = $id is NOT root"
    exit 2
  fi
}

check_dir 1 "$ANDROID_ASSETS/"
check_dir 1 "$ANDROID_DATA/app/"
check_dir 3 "$ANDROID_DATA/user/0/"
check_uid
